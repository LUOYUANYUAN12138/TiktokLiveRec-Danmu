<ui:FluentWindow x:Class="TiktokLiveRec.Views.LivePreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
                 Title="直播预览"
                 Width="960"
                 Height="600"
                 MinWidth="420"
                 MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#22000000"
                BorderThickness="0,0,0,1">
            <ui:TitleBar Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                         Foreground="#111111"
                         ShowMaximize="True">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/Favicon.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </Border>

        <Grid Grid.Row="1" Background="#111111">
            <wfi:WindowsFormsHost x:Name="PreviewHost"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />

            <Border x:Name="StatusOverlay"
                    Background="#88000000"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                    <ProgressBar x:Name="LoadingProgressBar"
                                 Width="180"
                                 Height="4"
                                 IsIndeterminate="True" />
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               Text="正在连接直播流..." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
